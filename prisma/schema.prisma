generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

// Retail / batch / wholesale channel derived from total quantity
enum OrderChannel {
  RETAIL
  BATCH
  WHOLESALE
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum RelationKind {
  SIMILAR
  COMPLEMENT
  BOUGHT_TOGETHER
}

// ---------------------------------------------------------------
// Users
// ---------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  fullName     String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)

  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses          Address[]
  cartItems          CartItem[]
  orders             Order[]
  chatMessages       ChatMessage[]
  passwordResetTokens PasswordResetToken[]
  verificationCodes  VerificationCode[]

  @@index([role])
}

model Address {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  label      AddressLabel @default(HOME)
  fullName   String
  phone      String
  province   String
  city       String
  postalCode String
  line1      String
  line2      String?
  isDefault  Boolean      @default(false)

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orders     Order[]

  @@index([userId])
}

// ---------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  sku           String?  @unique
  name          String
  shortDesc     String?
  description   String

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  material      String
  color         String?
  diameterCm    Float
  heightCm      Float
  weightGrams   Int

  stock         Int      @default(0)
  unitsPerCarton Int     @default(6)
  bundleSize    Int      @default(1)
  minOrderQuantity Int   @default(1)
  bundleItems   Json?
  colorOptions  Json?
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  allowBatchDiscount Boolean @default(true)
  isFragile     Boolean  @default(false)

  // Admin-defined display-only features, stored as [{ label, enabled }].
  // JSON rather than a table because the shopkeeper owns the whole list: it is
  // never queried, filtered or priced against, only rendered on the product
  // page. The two flags above (isActive, isFeatured) stay real columns because
  // catalogue queries and ordering read them.
  features      Json?

  basePriceToman Int
  salePriceToman Int?

  images        ProductImage[]
  tiers         PriceTier[]
  tags          ProductTag[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  relationsFrom ProductRelation[] @relation("RelationsFrom")
  relationsTo   ProductRelation[] @relation("RelationsTo")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  products  ProductTag[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([slug])
}

model ProductTag {
  productId String
  tagId     String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model LandingImage {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model StaticContent {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  body        String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// Tiered pricing matrix: single source of truth for per-unit price
model PriceTier {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  minQuantity    Int
  unitPriceToman Int
  label          String?

  @@unique([productId, minQuantity])
  @@index([productId])
}

// Product recommendation links
model ProductRelation {
  id        String       @id @default(cuid())
  fromId    String
  from      Product      @relation("RelationsFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Product      @relation("RelationsTo", fields: [toId], references: [id], onDelete: Cascade)
  kind      RelationKind
  score     Float        @default(0)
  manual    Boolean      @default(false)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([fromId, toId, kind])
  @@index([fromId, kind])
  @@index([toId])
}

// ---------------------------------------------------------------
// Cart
// ---------------------------------------------------------------

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  colorData Json?
  selectedColorHex String?
  colorAdjustment  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// ---------------------------------------------------------------
// Orders
// ---------------------------------------------------------------

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  channel     OrderChannel @default(RETAIL)

  subtotalToman  Int
  discountToman  Int @default(0)
  shippingToman  Int @default(0)
  totalToman     Int

  totalWeightGrams Int @default(0)
  totalCartons     Int @default(0)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Zarinpal fields
  zarinpalAuthority String?  @unique
  refId             String?
  cardPan           String?
  paidAt            DateTime?
  failureReason     String?

  // Shipping snapshot (address may change later)
  addressId      String?
  address        Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shipFullName   String
  shipPhone      String
  shipProvince   String
  shipCity       String
  shipPostalCode String
  shipLine1      String
  shipLine2      String?

  shippingCarrier String?
  trackingCode  String?
  shippedAt     DateTime?
  deliveredAt   DateTime?

  note          String?
  items         OrderItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([paymentStatus])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot fields: order history must not change if the product changes
  productName   String
  productSlug   String
  sku           String?
  imageUrl      String?
  material      String?
  diameterCm    Float?
  heightCm      Float?

  quantity         Int
  listUnitToman    Int
  unitToman        Int
  lineTotalToman   Int
  lineSavingsToman Int @default(0)
  tierLabel        String?
  colorData        Json?
  isBundle         Boolean @default(false)
  bundleSize       Int     @default(1)

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------
// Chatbot
// ---------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum VerificationType {
  PASSWORD_RESET
  REGISTER
  PHONE_CHANGE
  LOGIN_OTP
}

model VerificationCode {
  id        String           @id @default(cuid())
  phone     String
  codeHash  String
  type      VerificationType @default(PASSWORD_RESET)
  attempts  Int              @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([phone, type])
  @@index([expiresAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String
  role      String
  content   String
  escalated Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model WholesaleInquiry {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  businessName String?
  estimatedQty String
  message      String?
  status       String   @default("NEW")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model GlobalColor {
  id        String   @id @default(cuid())
  name      String   @unique
  hexCode   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model PageView {
  id        String   @id @default(cuid())
  path      String   // The URL path (e.g., "/products/slug")
  ipHash    String   // SHA-256 hash of IP + User-Agent + daily salt for unique visitors
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}

model StoreSettings {
  id              String   @id @default("singleton")
  originProvince  String   @default("تهران")
  originCity      String   @default("تهران")
  updatedAt       DateTime @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?  // Short summary for the list page
  content     String   // Rich HTML content
  coverImage  String?  // URL to the main image
  tags        String[] // Array of tags for filtering
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@index([slug])
}

